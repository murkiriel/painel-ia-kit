{
  "name": "painel-ia-kit-modelo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db": "node scripts/dev-db.ts",
    "load": "node scripts/dash.ts load",
    "thumbnail": "node scripts/thumbnail.ts",
    "dash": "node scripts/dash.ts",
    "outlines": "node scripts/dash.ts outlines",
    "check": "node scripts/dash.ts check",
    "api": "node --env-file=.env --watch server/main.ts",
    "web": "vite",
    "build": "vite build",
    "build:static": "node scripts/dash.ts build-static",
    "start": "node --env-file=.env server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\" \"dashboards/*/test/*.test.ts\"",
    "check:security": "node scripts/check-security.ts",
    "check:login": "node --env-file-if-exists=.env scripts/check-login.ts",
    "check:month": "node --env-file-if-exists=.env scripts/check-month.ts",
    "check:engines": "node scripts/compare-engines.ts",
    "check:static": "node scripts/dash.ts check-static",
    "check:agent": "node scripts/dash.ts check-agent"
  },
  "dependencies": {
    "@ag-grid-community/locale": "36.2.0",
    "@anthropic-ai/sdk": "1.3.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "echarts": "6.1.0",
    "maplibre-gl": "6.16.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
