# Banco: vazio ou "postgres" usa o Postgres, o padrão. "sqlite" usa um arquivo, sem servidor nem porta, quando não houver banco disponível.
# Outro valor impede o servidor de subir. Veja "Escolher o banco" no README.
DB_ENGINE=
# Pasta dos dados locais: miniaturas dos cartões e, no SQLite, os arquivos (portal.sqlite e um por dashboard). Vazio usa .data, ignorada pelo git.
# Fique em uma pasta com acesso só de quem administra.
DATA_DIR=
# Só com DB_ENGINE=sqlite. Muda só a pasta dos arquivos do SQLite. Vazio usa DATA_DIR.
SQLITE_DIR=
# Só com DB_ENGINE=sqlite, ao rodar npm run db. Casas decimais do valor em R$. Vazio usa 2.
SQLITE_VALUE_SCALE=

# Em desenvolvimento com Postgres, npm run db cria o .env sozinho (porta DEV_DB_PORT, padrão 54329). Em produção, preencha sem valores no repositório.
# Com DB_ENGINE=sqlite, as linhas abaixo não são usadas.
# Cada dashboard tem os próprios usuários de banco, de leitura e de carga, só com permissão no schema dele. O nome da variável é o do schema:
PRODUCAO_AGRICOLA_DATABASE_URL=postgres://producao_agricola_reader:senha@servidor:5432/dashboard
PRODUCAO_AGRICOLA_LOAD_DATABASE_URL=postgres://producao_agricola_loader:senha@servidor:5432/dashboard
# O portal: login e administração (pessoas, sessões e acessos). Nenhum dos dois enxerga os dados dos dashboards.
AUTH_DATABASE_URL=postgres://dash_auth:senha@servidor:5432/dashboard
PORTAL_DATABASE_URL=postgres://dash_portal:senha@servidor:5432/dashboard
DEV_DB_PORT=

# local: sem login, só na própria máquina. login: obrigatório para dado interno. Outro valor impede o servidor de subir.
AUTH_MODE=local
PORT=8787
# Só vale com AUTH_MODE=login e depois de criado o primeiro login. Sem nenhum usuário, o servidor só escuta nesta máquina.
HOST=0.0.0.0
# Ligue quando o servidor estiver atrás de HTTPS.
COOKIE_SECURE=false

# Vale para o dashboard de produção agrícola. Vazio deixa o mês desligado, como no exemplo, que é anual. "on" liga: veja "Ligar o mês" no README.
MONTH_FILTER=

# O provedor do agente é um só por projeto, e vale para todos os dashboards. Cada dashboard diz, no cartão, se tem agente. Vazio deixa o agente desligado. "simulado" serve para desenvolver e testar a tela. "claude" usa a API do Claude, com chave. "assinatura" usa o Claude Code logado nesta máquina, sem chave: com login, só se os usuários forem o dono da assinatura.
AGENT_PROVIDER=
# Vazio usa o modelo padrão do adaptador.
AGENT_MODEL=
# Só para testar na própria máquina, com uma chave dedicada e limite de gasto.
# Em produção, use um cofre de segredos ou as variáveis protegidas do servidor.
ANTHROPIC_API_KEY=
# Só com "assinatura". Vazios: acha o executável na extensão do VS Code e usa o login do Claude Code.
AGENT_CLAUDE_EXE=
AGENT_CLAUDE_TOKEN=
AGENT_LIMIT_PER_HOUR=60

# Memória da conversa do agente: por pessoa e por dashboard, só na memória do servidor (nada em banco, arquivo ou registro).
# Cada pergunta nova recebe como contexto as últimas trocas da conversa. Valor inválido impede o servidor de subir.
# O portal roda numa VPS com pouca memória: os dois últimos são os tetos. Passou o de conversas, sai a usada há mais tempo; passou o de caracteres de uma conversa, saem as trocas mais antigas.
# Quantas trocas (pergunta e resposta) a conversa guarda, de 1 a 20.
AGENT_MEMORY_TURNS=5
# Minutos sem uso até a conversa ser esquecida, de 1 a 1440. Sair e o botão "Nova conversa" também a esquecem.
AGENT_MEMORY_IDLE_MINUTES=120
# Conversas guardadas ao mesmo tempo, de 1 a 5000.
AGENT_MEMORY_MAX_CONVERSATIONS=200
# Caracteres de uma conversa (perguntas e respostas), de 1000 a 200000.
AGENT_MEMORY_MAX_CHARS=20000

# Limite do site estático: acima dele, npm run build:static recusa. Vazio usa 200 MB e 100 mil arquivos.
STATIC_MAX_MB=
STATIC_MAX_FILES=

# Para criar usuários em produção com scripts/create-user.ts.
ADMIN_DATABASE_URL=

# Outra pasta para a tela montada (npm run build usa dist).
WEB_DIR=
